{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>{{ .Site.Title }}</title><link>{{ .Site.BaseURL }}</link><description>{{ .Site.Params.description }}</description><language>zh-CN</language><atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
{{ $pages := where .Site.RegularPages "Section" "posts" }}{{ if not .IsHome }}{{ $pages = .RegularPages }}{{ end }}{{ range $pages.ByDate.Reverse }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate><description>{{ .Description | default .Summary | html }}</description></item>{{ end }}
</channel></rss>
